{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.runpod.io/*" },
        { "url": "https://*.proxy.runpod.net/*" },
        { "url": "https://huggingface.co/*" }
      ]
    }
  ]
}
